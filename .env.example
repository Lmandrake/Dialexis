# Dialexis configuration — copy to .env (gitignored) and edit. Every value is optional;
# each line records the default that applies when the variable is unset.
#
# scripts/paths.py reads this file itself (stdlib only, KEY=VALUE lines, os.environ wins
# over a line here), so no shell export and no python-dotenv is needed for anything in
# scripts/. `~` is expanded. Blank lines and #-comments are ignored.

# ---------------------------------------------------------------------------
# Content roots — where YOUR data lives, as opposed to the machinery
# ---------------------------------------------------------------------------
# One switch for a whole self-contained content world (graph/, agenda/, archive/, inbox/,
# batches/, output/, index cache, access log all live under it). Same as
# `run.py --graph-root PATH`. When set it WINS over every per-root variable below.
# Default: unset (the per-root variables and their defaults apply)
# DIALEXIS_GRAPH_ROOT=~/dev/Dialexis/examples/demo-graph

# Or set these three together to keep a private knowledge graph outside a public checkout.
# They may point anywhere, including outside the repo; paths recorded in manifests and
# batch metadata come out absolute in that case and still resolve.

# The knowledge graph: the entity markdown files that ARE the database.
# Default: <repo>/graph
# DIALEXIS_MODEL_DIR=~/example-data/graph

# Kairos's agenda ledger, worklog, quarterly archive and worker profile.
# Default: <repo>/agenda
# DIALEXIS_AGENDA_DIR=~/example-data/agenda

# Immutable source copies (raw_inbox/), retired entities, source ledger, PRUNED_LOG.md.
# Default: <repo>/archive
# DIALEXIS_ARCHIVE_DIR=~/example-data/archive

# ---------------------------------------------------------------------------
# Ingestion
# ---------------------------------------------------------------------------
# The ONLY drop zone stage_inbox reads. There is deliberately no repo-local fallback:
# unset, stage_inbox refuses to run rather than silently accumulate an unsynced inbox.
# Default: unset (no inbox)
# DIALEXIS_INBOX_DIR=<shared-inbox>

# ---------------------------------------------------------------------------
# Drive Bridge (publish) — publish host only; see deploy/README.md
# ---------------------------------------------------------------------------
# Hostname (`hostname -s`) allowed to publish. A mismatch makes publish a no-op, which is
# how other machines are prevented from overwriting the mirror.
# Default: unset (publishing disabled)
# DIALEXIS_PUBLISH_HOST=my-host

# Destination for the one-way read-only Drive mirror.
# Default: unset (publishing disabled)
# DIALEXIS_PUBLISH_DIR=<mirror-dir>

# Comma-separated entity dirs to mirror.
# Default: people,organizations,projects,programs,events,places,documents,dreams,technology_concepts,technology_systems
# DIALEXIS_PUBLISH_DIRS=people,organizations,projects

# ---------------------------------------------------------------------------
# Rarely needed
# ---------------------------------------------------------------------------
# The derived SQLite index cache. Per-machine and never committed — it is rebuildable
# from the markdown, so it costs less to regenerate than to sync.
# Default: ~/.cache/dialexis/<hash of the model dir>
# DIALEXIS_INDEX_DIR=~/.cache/dialexis/custom

# The task-board checkout, for the board -> Kairos airlock queue and receipts file.
# Default: a sibling checkout
# DIALEXIS_LODESTAR_DIR=a sibling checkout

# ---------------------------------------------------------------------------
# Slack relay (slack/bot.py, one host only) — read via python-dotenv, NOT paths.py
# ---------------------------------------------------------------------------
# Repo root for the relay's `claude -p` subprocess. Default: ~/dev/Dialexis
# DIALEXIS_ROOT=~/dev/Dialexis
# SLACK_BOT_TOKEN=xoxb-...        # bot token
# SLACK_APP_TOKEN=xapp-...        # app-level token, connections:write, for Socket Mode
# CLAUDE_PATH=~/.local/bin/claude # default: /Users/<you>/.local/bin/claude
# CLAUDE_MODEL=opus               # default: opus
# CLAUDE_TIMEOUT=120              # seconds; default: 120
# Who may use the relay (Slack user IDs, comma-separated). REQUIRED: unset, the bot exits.
# Owners get the full writer relay. Contributors get read-only lookups, and anything they
# contribute is written to DIALEXIS_INBOX_DIR as a note for later careful ingestion; their
# claude -p runs --restricted with Read/Grep/Glob only, confined to the model dir.
# Everyone else is refused.
# DIALEXIS_SLACK_OWNERS=U0000000000
# DIALEXIS_SLACK_CONTRIBUTORS=U1111111111,U2222222222
# Auth for the restricted run is copied from here (settings + env). Default shown.
# CLAUDE_SETTINGS=~/.claude/settings.json
